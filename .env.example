# Application
NODE_ENV=production
PORT=3000
APP_URL=https://api.traka.app

# Database
DATABASE_URL=postgresql://traka:password@localhost:5432/traka
POSTGRES_DB=traka
POSTGRES_USER=traka
POSTGRES_PASSWORD=change-this-password

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Upstash QStash (for queues and background jobs)
QSTASH_TOKEN=your-qstash-token

# Webhook delivery (QStash-backed retries)
# Number of retries before the delivery is marked dead (default 5 => 6 total attempts)
WEBHOOK_RETRIES=5
# Base delay in ms for the exponential backoff between retries (default 30000)
WEBHOOK_RETRY_BASE_MS=30000
# Timeout in ms when delivering the webhook to your endpoint (default 10000)
WEBHOOK_TIMEOUT_MS=10000

# JWT
JWT_SECRET=change-this-to-random-32-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-32-char-string
TRACKING_TOKEN_SECRET=change-this-to-another-random-32-char-string

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# SMS (Optional - KudiSMS)
KUDISMS_API_KEY=your-kudisms-api-key

# File Upload (Optional - Backblaze B2)
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-app-key
B2_BUCKET_ID=your-bucket-id
B2_BUCKET_NAME=your-bucket-name

# Firebase (Optional - for push notifications)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# Google Maps (Optional)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# CORS (comma-separated; supports wildcard subdomains e.g. https://*.onrender.com)
CORS_ORIGIN=https://app.traka.com,https://*.onrender.com

# Monitoring (Optional)
SENTRY_DSN=your-sentry-dsn
