{
  "info": {
    "name": "TRAKA - Upload & Profile Photo",
    "description": "File upload and profile photo management endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Upload",
      "item": [
        {
          "name": "Upload Profile Photo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/upload/profile",
              "host": ["{{base_url}}"],
              "path": ["upload", "profile"]
            },
            "description": "Upload and optimize profile photo. Image is automatically resized to 1200px width and compressed to 85% quality."
          },
          "response": []
        },
        {
          "name": "Upload Vehicle Photo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
