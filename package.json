{
  "name": "traka",
  "version": "1.0.0",
  "description": "Secure package tracking logistics",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "prestart": "tsc",
    "build": "tsc",
    "dev": "NODE_ENV=development nodemon --exec tsx src/index.ts",
    "start": "node dist/src/index.js",
    "start:dev": "NODE_ENV=development node dist/src/index.js",
    "start:staging": "NODE_ENV=staging node dist/src/index.js",
    "start:prod": "NODE_ENV=production node dist/src/index.js",
    "seed:admins": "tsc && node dist/scripts/seed-admins.js",
    "seed:legal": "tsc -p tsconfig.seed.json && node dist/scripts/seed-legal.js",
    "migrate:up": "tsc && node dist/scripts/migrate.js up",
    "migrate:down": "tsc && node dist/scripts/migrate.js down",
    "migrate:pending": "tsc && node dist/scripts/migrate.js pending",
    "migrate:executed": "tsc && node dist/scripts/migrate.js executed",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "test:integration": "NODE_ENV=test jest --testPathPattern=tests/integration",
    "test:sms": "tsx tests/test-sms.ts",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "check": "biome check --write src/"
  },
  "keywords": [],
  "author": "Stephen Oyeyemi",
  "license": "ISC",
  "packageManager": "pnpm@10.18.3",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "axios": "^1.13.2",
    "backblaze-b2": "^1.7.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.6.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.3.0",
    "multer": "^2.0.2",
    "nanoid": "^5.1.6",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "sequelize": "^6.35.0",
    "sequelize-typescript": "^2.1.6",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.2",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^2.0.16",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/winston": "^2.4.4",
    "@types/yamljs": "^0.2.34",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
