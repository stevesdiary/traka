# Database Configuration
POSTGRES_URL=postgresql://user:password@localhost:5432/traka
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://localhost:27017/traka

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here

# Server Configuration
PORT=4000
NODE_ENV=development

# Financial Configuration
RIDER_COMMISSION_RATE=0.20
RIDER_CREDIT_LIMIT=-2000.00
PLATFORM_FEE_RATE_BUSINESS=0.15

# Payment Gateway
MONNIFY_SECRET_KEY=your-monnify-secret-key
MONNIFY_API_KEY=your-monnify-api-key
MONNIFY_CONTRACT_CODE=your-monnify-contract-code

# Email Configuration (Brevo)
BREVO_API_KEY=your-brevo-api-key
SMTP_FROM=noreply@traka.com

# SMS Configuration (KudiSMS)
KUDISMS_API_TOKEN=your-kudisms-api-token
KUDISMS_SENDER_ID=TRAKA
KUDISMS_GATEWAY=2

# Push Notifications (Firebase)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"key-id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com"}