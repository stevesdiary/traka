# Database Configuration
POSTGRES_URL=postgresql://user:password@localhost:5432/dbname
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://localhost:27017/traka

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here

# Server Configuration
PORT=4000
NODE_ENV=development

# Financial Configuration
RIDER_COMMISSION_RATE=0.20
RIDER_CREDIT_LIMIT=-2000.00
PLATFORM_FEE_RATE_BUSINESS=0.15

# Payment Gateway
PAYMENT_PROVIDER=MONNIFY
MONNIFY_SECRET_KEY=your-monnify-secret-key
MONNIFY_API_KEY=your-monnify-api-key
MONNIFY_CONTRACT_CODE=your-monnify-contract-code
MONNIFY_BASE_URL=https://sandbox.monnify.com
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_BASE_URL=https://api.paystack.co
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key
FLUTTERWAVE_WEBHOOK_HASH=your-flutterwave-webhook-hash
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
PAYMENT_CALLBACK_URL=https://your-frontend-or-api/callback

# Email Configuration (Brevo)
BREVO_API_KEY=your-brevo-api-key
SMTP_FROM=noreply@traka.com

# SMS Configuration (KudiSMS)
KUDISMS_API_TOKEN=your-kudisms-api-token
KUDISMS_SENDER_ID=TRAKA
KUDISMS_GATEWAY=2

# Geocoding Configuration (Optional)
GEOCODING_NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODING_PHOTON_URL=https://photon.komoot.io
GEOCODING_USER_AGENT=agentName/1.0
GEOCODING_COUNTRY_CODE=ng

# Push Notifications (Firebase)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"key-id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com"}

# Backblaze B2 Storage
B2_ENDPOINT=https://s3.us-west-000.backblazeb2.com
B2_KEY_ID=your-key-id
B2_APPLICATION_KEY=your-application-key
B2_BUCKET_NAME=your-bucket-name
