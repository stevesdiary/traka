          "name": "Calculate Bulk Pricing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup_address\": \"456 Pickup St, City, State\",\n  \"deliveries\": [\n    {\n      \"delivery_address\": \"123 Main St, City, State\",\n      \"package_size\": \"MEDIUM\",\n      \"package_weight\": 2.5\n    },\n    {\n      \"delivery_address\": \"789 Oak Ave, City, State\",\n      \"package_size\": \"SMALL\",\n      \"package_weight\": 1.0\n    },\n    {\n      \"delivery_address\": \"321 Pine St, City, State\",\n      \"package_size\": \"LARGE\",\n      \"package_weight\": 5.0\n    }\n  ],\n  \"delivery_speed\": \"STANDARD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pricing/bulk-calculate",
              "host": ["{{baseUrl}}"],
              "path": ["pricing", "bulk-calculate"]
            }
          }
        }
      ]
    },
